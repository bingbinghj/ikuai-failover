# 宿主机绑定地址；127.0.0.1 仅允许本机访问，需要局域网访问时填写宿主机地址。
FAILOVER_BIND_IP=127.0.0.1
# 爱快路由器管理账号密码。可留空，在网页或 data/config.yml 的 ikuai 字段中填写。
# 非空环境变量会覆盖配置文件；这两项不是网页登录账号密码。
IKUAI_FAILOVER_USERNAME=
IKUAI_FAILOVER_PASSWORD=
# 本服务的网页登录账号密码，对应 webui.user/pass，与爱快账号独立。
# 环境变量和配置均未填写时，随机生成缺失字段并保存到 data/config.yml。
IKB_WEBUI_USER=
IKB_WEBUI_PASS=
# 通知渠道凭据。也可以在网页中填写；非空环境变量优先。
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_WECHAT_SECRET=
NOTIFY_QYWECHAT_WEBHOOK=
NOTIFY_FEISHU_SECRET=
NOTIFY_CLAWBOT_TOKEN=
NOTIFY_SLACK_TOKEN=
NOTIFY_DISCORD_TOKEN=
NOTIFY_DINGTALK_WEBHOOK=
NOTIFY_DINGTALK_SECRET=
NOTIFY_SYNOLOGY_WEBHOOK=
NOTIFY_VOCECHAT_KEY=
NOTIFY_WEB_RECEIVE_URL=
NOTIFY_WEB_TOKEN=
NOTIFY_WEBAGENT_RECEIVE_URL=
NOTIFY_WEBAGENT_TOKEN=
NOTIFY_WEBPUSH_SUBSCRIPTIONS=
NOTIFY_WEBPUSH_PRIVATE_KEY=
NOTIFY_APPPUSH_RELAY_KEY=
NOTIFY_QQ_SECRET=
